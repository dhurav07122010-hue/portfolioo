# ==============================================================================
# DS STUDIOS — PRODUCTION EMAIL ENVIRONMENT CONFIGURATION
# ==============================================================================

# OPTION 1: Resend (RECOMMENDED FOR VERCEL)
# Sign up at https://resend.com (Free tier: 3,000 emails/month)
# Create an API Key in Resend dashboard -> API Keys
RESEND_API_KEY=re_your_api_key_here

# The recipient email where contact form inquiries should be delivered
CONTACT_TO_EMAIL=ds.studio.buissness@gmail.com

# The verified sender email (Default: DS Studios <onboarding@resend.dev> for testing, or your domain like contact@dsstudios.in)
CONTACT_FROM_EMAIL=DS Studios <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# OPTION 2: SMTP / Gmail (ALTERNATIVE)
# If using Gmail, generate an App Password at:
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ds.studio.buissness@gmail.com
# SMTP_PASS=your_16_character_app_password
